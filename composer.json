{
	"name": "b13/page-info-tabs",
	"type": "typo3-cms-extension",
	"description": "Organizes page module header sections into Bootstrap 5 tabs",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "b13 GmbH",
			"email": "typo3@b13.com",
			"homepage": "https://b13.com"
		}
	],
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^13 || ^14",
		"typo3/cms-backend": "^13 || ^14",
		"typo3/cms-fluid": "^13 || ^14"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5 || ^11.0"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "page_info_tabs",
			"version": "1.0.2"
		}
	},
	"autoload": {
		"psr-4": {
			"B13\\PageInfoTabs\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"B13\\PageInfoTabs\\Tests\\": "Tests/"
		}
	},
	"scripts": {
		"test:unit": "phpunit --testdox"
	}
}
